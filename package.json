{
  "name": "@jordyvanvorselen/pi-interactive-subagents",
  "version": "1.2.0",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in Herdr panes",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordyvanvorselen/pi-interactive-subagents.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^24.19.2",
    "typebox": "^1.4.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "pi-extension",
    "agents",
    "config.json.example",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "undici": "^8.12.3"
  }
}
