{
  "name": "@jordyvanvorselen/pi-interactive-subagents",
  "version": "1.0.0",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in Herdr panes",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordyvanvorselen/pi-interactive-subagents.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.65.0",
    "@mariozechner/pi-tui": "^0.65.0",
    "@sinclair/typebox": "^0.34.49"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "pi-extension",
    "agents",
    "config.json.example",
    "README.md",
    "LICENSE"
  ]
}
